# Mall 电商系统 — 环境变量模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
#
# 说明：config.yaml 里保留了本地开发默认值（docker-compose 的端口/弱口令），
# 生产环境务必用下面的环境变量覆盖，且不要把 .env 提交进仓库。

# ---- 数据库 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mall
MYSQL_USERNAME=mall
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ---- Meilisearch（搜索引擎，替代 Elasticsearch）----
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=change-me-meili-master-key

# ---- 安全（生产必填）----
# JWT 密钥：至少 32 位随机字符串；为空时服务拒绝启动
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# AES_KEY：16/24/32 位，余额字段加密；生产缺失时拒绝启动
AES_KEY=change-me-16byte
# CORS 白名单，逗号分隔；同源部署可留空（不返回任何 CORS 头）
CORS_ORIGINS=https://syloe1.xyz,https://mall.syloe1.xyz
# 演示模式：开启后挂载模拟支付接口、登录页展示演示账号
DEMO_MODE=true
# HTTPS 部署时置 true（refresh token Cookie 加 Secure）
COOKIE_SECURE=true
# 只信任这些反向代理传来的 X-Forwarded-For（默认本机）
TRUSTED_PROXIES=127.0.0.1,::1
